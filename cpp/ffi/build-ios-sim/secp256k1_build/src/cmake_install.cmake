set(CMAKE_BINARY_DIR "/Users/alekseypopkov/Doc/nostr_notes/nostr_notes/cpp/ffi/build-ios-sim")

if(NOT PLATFORM_NAME)
  if(NOT "$ENV{PLATFORM_NAME}" STREQUAL "")
