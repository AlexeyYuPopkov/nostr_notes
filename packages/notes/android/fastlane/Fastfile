require 'shellwords'

# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Deploy a beta version to Google Play"
  lane :deploy do |options|
    track_name = options[:track] || 'internal' # по умолчанию internal

    # Формат: 1.0.0+10
    pubspec_path = "../../pubspec.yaml"
    current_pubspec = File.read(pubspec_path)
    version_parts = current_pubspec.match(/version: (.+)/)[1].split('+')
    version_name = version_parts[0]
    pubspec_code = version_parts[1].to_i

    # Номер спрашиваем у Google Play, как iOS спрашивает его у TestFlight
    # (latest_testflight_build_number). Раньше он выводился только из
    # pubspec.yaml, а CI не коммитит бамп обратно — поэтому каждый прогон
    # заново получал одно и то же число и падал с "Version code N has
    # already been used". Черновики и закрытые треки номер тоже занимают,
    # так что берём максимум по всем трекам.
    used_codes = %w[internal alpha beta production].flat_map do |track|
      begin
        google_play_track_version_codes(track: track)
      rescue StandardError => e
        UI.message("Трек #{track} пропущен: #{e.message}")
        []
      end
    end

    # pubspec как нижняя граница: если API почему-то не покажет занятый
    # номер, версия из репозитория всё равно не даст откатиться назад.
    new_code = [used_codes.map(&:to_i).max.to_i, pubspec_code].max + 1
    UI.important("versionCode: #{new_code}")

    updated_pubspec = current_pubspec.gsub(
      /version: .+/, "version: #{version_name}+#{new_code}"
    )
    File.write(pubspec_path, updated_pubspec)
    
    # Собираем AAB через Flutter
    sh("cd ../.. && flutter clean") # опционально, для чистой сборки
    sh("cd ../.. && flutter pub get")
    sh("cd ../.. && flutter build appbundle --release --obfuscate --split-debug-info=build/debug-info")

    # Собираем APK для прямой дистрибуции
    sh("cd ../.. && flutter build apk --release --obfuscate --split-debug-info=build/debug-info")
    
    # Генерируем чексумму для APK
    sh("cd ../../build/app/outputs/flutter-apk && sha256sum app-release.apk > app-release.apk.sha256")

    # Загружаем в Google Play (использует SUPPLY_JSON_KEY_FILE из env)
    upload_to_play_store(
      track: track_name,
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      release_status: "draft"  # 👈 временно загружаем как черновик
    )
  end
end