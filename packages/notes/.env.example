# Copy this file to .env and fill in your own values.
# .env is git-ignored and never committed.

# LUD-16 lightning address used for in-app donation zaps (NIP-57).
DEV_LIGHTNING_ADDRESS=your_lightning_address@wallet.example

# Nostr hex public key of the developer account (receives zap events).
DEV_NOSTR_PUBKEY=your_nostr_hex_pubkey_here

# Ko-fi donation page URL.
KOFI_URL=https://ko-fi.com/your_page

# AdMob. App IDs live in ios/Runner/Info.plist and AndroidManifest.xml; only the
# ad unit ids are read from here. The values below are Google's public test
# units — replace them with the real ones from the AdMob console.
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-3940256099942544/4411468910
ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-3940256099942544/1033173712
ADMOB_BANNER_ID_IOS=ca-app-pub-3940256099942544/2934735716
ADMOB_BANNER_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
